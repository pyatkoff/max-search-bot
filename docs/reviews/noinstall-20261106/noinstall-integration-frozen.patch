+#!/usr/bin/env node
+'use strict';
+
+// One adapter for release identity. The existing Python V2 owns content/intent
+// classification; release_slot_close.js remains the sole publisher owner.
+const fs = require('node:fs');
+const path = require('node:path');
+const crypto = require('node:crypto');
+const cp = require('node:child_process');
+const REPOSITORY = 'pyatkoff/max-search-bot';
+const PREFIX = '/repos/' + REPOSITORY;
+const DEPLOY = '.github/workflows/deploy.yml';
+const CLOSER = '.github/workflows/modeled-conversion-value-export.yml';
+const DECISION = 'deployment-decision-v1';
+const ACCEPTED = 'accepted-release-v1';
+const MAX_JSON = 256 * 1024;
+const MAX_ZIP = 512 * 1024;
+const INSTALL_STAGES = ['provenance','key','bundle','sync','migration','max_webhook',
+  'metrika_cron','install_checks','smoke','diagnostics'];
+const OPS_STAGES = ['migration','snapshot','live_sessions','daily_sessions','yesterday_sessions',
+  'architecture_inventory','website_smoke','health'];
+const INSTALL_STEPS = ['Build exact deployment bundle','Sync canonical production checkout',
+  'Apply database migrations and fence the old hotel contour','Reconcile canonical MAX webhook ownership',
+  'Ensure Metrika offline uploader cron','Apply profile and retain exact diagnostic snapshot'];
+const sha = x => typeof x === 'string' && /^[0-9a-f]{40}$/.test(x);
+const hash = x => typeof x === 'string' && /^[0-9a-f]{64}$/.test(x);
+const id = x => Number.isSafeInteger(x) && x > 0;
+const object = x => x !== null && typeof x === 'object' && !Array.isArray(x);
+const stamp = x => typeof x === 'string' && /^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$/.test(x) && Number.isFinite(Date.parse(x));
+class ReleaseError extends Error { constructor(code) { super(code); this.code = code; } }
+function requireValue(ok, code) { if (!ok) throw new ReleaseError(code); }
+function digest(bytes) { return crypto.createHash('sha256').update(bytes).digest('hex'); }
+function equivalent(a,b) { return JSON.stringify(a) === JSON.stringify(b); }
+function canonical(value) {
+  if(Array.isArray(value)) return value.map(canonical);
+  if(object(value)) return Object.fromEntries(Object.keys(value).sort().map(k=>[k,canonical(value[k])]));
+  return value;
+}
+function runtimeDigest(value) {
+  return digest(JSON.stringify(canonical({schema:1,application_sha:value.application_sha,components:value.components})));
+}
+
+function validateRuntime(value) {
+  requireValue(object(value) && value.schema === 1 && value.ok === true && sha(value.application_sha)
+    && hash(value.fingerprint) && stamp(value.observed_at) && object(value.components)
+    && Buffer.byteLength(JSON.stringify(value)) <= 32768 && runtimeDigest(value)===value.fingerprint, 'runtime_unconfirmed');
+  return value;
+}
+function sameRuntimeState(a,b) {
+  validateRuntime(a); validateRuntime(b);
+  return a.application_sha === b.application_sha && a.fingerprint === b.fingerprint;
+}
+function validateOrigin(value) {
+  requireValue(object(value) && sha(value.application_sha) && id(value.install_run_id)
+    && value.deploy_attempt === 1 && id(value.closer_run_id), 'installation_origin_invalid');
+  const d=value.deploy_status, o=value.ops_status;
+  requireValue(object(d) && d.schema === 2 && d.sha === value.application_sha
+    && String(d.run_id) === String(value.install_run_id) && d.install_attempt === 1
+    && [1,2].includes(d.smoke_attempt) && [1,2].includes(d.diagnostics_attempt)
+    && stamp(d.reported_at) && INSTALL_STAGES.every(k=>d[k]==='success'), 'installation_origin_unconfirmed');
+  requireValue(object(o) && o.sha === value.application_sha && OPS_STAGES.every(k=>o[k]==='success'),
+    'installation_diagnostics_unconfirmed');
+  return value;
+}
+function validateDecision(value) {
+  requireValue(object(value) && value.schema === 1 && value.protocol === 'anytour-deployment-decision-v1'
+    && ['installed','application_unchanged'].includes(value.outcome) && value.completed === false
+    && sha(value.repository_sha) && sha(value.application_sha) && id(value.release_run_id)
+    && value.release_attempt === 1 && typeof value.installation_performed === 'boolean', 'decision_invalid');
+  if(value.outcome==='installed') {
+    requireValue(value.repository_sha===value.application_sha && value.installation_performed===true
+      && !value.original_installation && !value.baseline_ref, 'installed_decision_invalid');
+  } else {
+    validateOrigin(value.original_installation); validateRuntime(value.runtime_snapshot);
+    const b=value.baseline_ref, c=value.comparison;
+    requireValue(value.repository_sha!==value.application_sha && value.installation_performed===false
+      && value.original_installation.application_sha===value.application_sha
+      && value.runtime_snapshot.application_sha===value.application_sha
+      && object(b) && id(b.artifact_id) && id(b.closer_run_id) && sha(b.repository_sha) && hash(b.digest)
+      && object(c) && c.runtime_contents_unchanged===true && c.release_path==='content_candidate'
+      && c.installed_sha===value.application_sha && c.candidate_sha===value.repository_sha
+      && c.installed_runtime_fingerprint===c.candidate_runtime_fingerprint && hash(c.candidate_runtime_fingerprint)
