+  if(await releasePending(transport,source,runs)) return {ready:false,repository_sha:source,application_sha:'',outcome:'pending',run_operations:false};
+  const accepted=await findAccepted({env,repositorySha:source,transport});
+  const latest=runs.filter(r=>r.path===DEPLOY).sort((a,b)=>b.id-a.id)[0];
+  requireValue(latest && latest.status==='completed' && latest.conclusion==='success', 'current_deployment_unconfirmed');
+  if(accepted && latest.id===accepted.value.release_run_id && latest.run_attempt===accepted.value.release_attempt)
+    return {ready:true,repository_sha:source,application_sha:accepted.value.application_sha,
+      outcome:accepted.value.outcome,run_operations:true};
+  requireValue(!accepted || latest.id>accepted.value.release_run_id, 'current_deployment_unconfirmed');
+  return installedObserverIdentity(transport,source,latest);
+}
+function outputs(env,result) {
+  requireValue(typeof env.GITHUB_OUTPUT==='string' && env.GITHUB_OUTPUT.length>0,'github_output_missing');
+  for(const [key,value] of Object.entries(result)) {
+    requireValue(/^[a-z_]+$/.test(key) && ['string','boolean'].includes(typeof value) && !/[\r\n]/.test(String(value)), 'output_invalid');
+    fs.appendFileSync(env.GITHUB_OUTPUT,key+'='+String(value)+'\n');
+  }
+}
+module.exports={REPOSITORY,DEPLOY,CLOSER,DECISION,ACCEPTED,INSTALL_STAGES,OPS_STAGES,INSTALL_STEPS,
+  ReleaseError,validateDecision,validateAccepted,validateRuntime,validateOrigin,sameRuntimeState,runtimeDigest,
+  makeTransport,trustedRun,artifactMetadata,decodeArtifact,readAcceptedRef,findAccepted,readDecision,
+  captureRuntime,currentContext,previewV2,admit,writeAccepted,verifyInstallerSkips,resolveConsumer,releasePending,
+  readReleaseRuns,installedObserverIdentity};
+if(require.main===module) (async()=>{
+  const args=process.argv.slice(2), mode=args[0], env=process.env;
+  requireValue(args.length===1 || args.length===2 && args[1]==='--json' && mode==='--resolve-consumer','mode_invalid');
+  let result;
+  if(mode==='--admit') {
+    const d=await admit({env}); writeRecord(localPath(env,'decision.json'),d);
+    result={outcome:d.outcome,application_sha:d.application_sha,run_operations:d.outcome==='installed'};
+  } else if(mode==='--verify-decision') {
+    const d=await readDecision({env,runId:Number(env.GITHUB_RUN_ID),repositorySha:env.GITHUB_SHA,allowInProgress:true});
+    if(d.outcome==='application_unchanged') await verifyInstallerSkips({env,decision:d});
+    result={outcome:d.outcome,application_sha:d.application_sha,run_operations:d.outcome==='installed'};
+  } else if(mode==='--resolve-consumer') result=await resolveConsumer({env});
+  else throw new ReleaseError('mode_invalid');
+  if(args[1]==='--json') process.stdout.write(JSON.stringify(result)+'\n');
+  else { outputs(env,result); process.stdout.write('release_resolution='+result.outcome+'\n'); }
+})().catch(e=>{process.stderr.write('release_resolution=refused reason='+(e instanceof ReleaseError?e.code:'internal_failure')+'\n');process.exitCode=1;});
