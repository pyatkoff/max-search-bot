+function deployContractStep(string $workflow, string $name): string {
+    $start = strpos($workflow, '      - name: '.$name."\n");
+    if ($start === false) return '';
+    $end = strpos($workflow, "\n      - name:", $start + 1);
+    $job = strpos($workflow, "\n  verify:", $start + 1);
+    if ($job !== false && ($end === false || $job < $end)) $end = $job;
+    return substr($workflow, $start, ($end === false ? strlen($workflow) : $end) - $start);
+}
+function deployContractScript(string $step): string {
+    $start = strpos($step, "        run: |\n");
+    if ($start === false) return '';
+    $script = '';
+    foreach (explode("\n", substr($step, $start + strlen("        run: |\n"))) as $line) {
+        if ($line !== '' && !str_starts_with($line, '          ')) break;
+        $script .= ($line === '' ? '' : substr($line, 10))."\n";
+    }
+    return $script;
+}
+function deployContractRun(string $script, array $env): bool {
+    if ($script === '') return false;
+    $process = proc_open(['bash', '-c', $script], [0 => ['file', '/dev/null', 'r'], 1 => ['file', '/dev/null', 'w'], 2 => ['file', '/dev/null', 'w']],
