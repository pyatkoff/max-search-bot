@@ -0,0 +1,326 @@
+<?php
+declare(strict_types=1);
+
+/** A bounded observation of the existing installation; never a repair or health export. */
+final class DeploymentRuntimeState
+{
+    public const ROOT = '/var/www/anytoour/data/www/app.anytoour.ru';
+    private const MAX_FILE = 1048576;
+
+    private static function need(bool $ok, string $reason): void
+    {
+        if (!$ok) throw new RuntimeException($reason);
+    }
+
+    public static function encoded(array $value): string
+    {
+        $sort = static function (array $v) use (&$sort): array {
+            if (!array_is_list($v)) ksort($v, SORT_STRING);
+            foreach ($v as $key => $item) if (is_array($item)) $v[$key] = $sort($item);
+            return $v;
+        };
+        return json_encode($sort($value), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR);
+    }
+
+    private static function directory(string $path): void
+    {
+        self::need(is_dir($path) && !is_link($path) && realpath($path) === $path, 'runtime_directory_unavailable');
+    }
+
+    /** No symlink traversal, unbounded reads, private values in errors, or permission repair. */
+    private static function file(string $path, int $limit = self::MAX_FILE): array
+    {
+        clearstatcache(true, $path);
+        $before = @lstat($path);
+        self::need(is_array($before) && ($before['mode'] & 0170000) === 0100000
+            && realpath($path) === $path && $before['size'] >= 0 && $before['size'] <= $limit, 'runtime_file_unavailable');
+        $handle = @fopen($path, 'rb');
+        self::need(is_resource($handle), 'runtime_file_unavailable');
+        try {
+            $opened = fstat($handle);
+            $raw = stream_get_contents($handle, $limit + 1);
+            $after = fstat($handle);
+            clearstatcache(true, $path);
+            $current = @lstat($path);
+            foreach ([$opened, $after, $current] as $stat) {
+                self::need(is_array($stat), 'runtime_file_changed');
+                foreach (['dev', 'ino', 'mode', 'size', 'mtime', 'ctime'] as $field)
+                    self::need($stat[$field] === $before[$field], 'runtime_file_changed');
+            }
+            self::need(is_string($raw) && strlen($raw) === $before['size'] && strlen($raw) <= $limit, 'runtime_file_changed');
+            return ['raw' => $raw, 'sha256' => hash('sha256', $raw), 'mode' => $before['mode'] & 0777];
+        } finally { fclose($handle); }
+    }
+
+    private static function metadata(string $path, int $limit = self::MAX_FILE): array
+    {
+        $file = self::file($path, $limit);
+        return ['sha256' => $file['sha256'], 'mode' => $file['mode']];
+    }
+
+    private static function document(string $path): array
+    {
+        $raw = self::file($path, 32768)['raw'];
+        $value = json_decode($raw, true, 32, JSON_THROW_ON_ERROR);
+        self::need(is_array($value), 'runtime_document_invalid');
+        return $value;
+    }
+
+    private static function absent(string $path): void
+    {
+        self::need(!file_exists($path) && !is_link($path), 'unfinished_component_operation');
+    }
+
+    private static function command(array $readers, array $arguments, string $reason): string
+    {
+        $result = ($readers['command'])($arguments);
+        self::need(is_array($result) && ($result['status'] ?? null) === 0
+            && is_string($result['stdout'] ?? null) && strlen($result['stdout']) <= 2097152, $reason);
+        return $result['stdout'];
+    }
+
+    private static function checkout(array $readers): string
+    {
+        $sha = trim(self::command($readers, ['git', 'rev-parse', '--verify', 'HEAD^{commit}'], 'runtime_source_unavailable'));
+        self::need(preg_match('/\A[a-f0-9]{40}\z/D', $sha) === 1, 'runtime_source_unavailable');
+        self::command($readers, ['git', 'diff', '--no-ext-diff', '--no-textconv', '--quiet'], 'tracked_checkout_drift');
+        self::command($readers, ['git', 'diff', '--cached', '--no-ext-diff', '--no-textconv', '--quiet'], 'tracked_index_drift');
+        $files = self::command($readers, ['git', 'ls-files', '-v', '-z'], 'runtime_inventory_unavailable');
+        self::need($files !== '' && str_ends_with($files, "\0"), 'runtime_inventory_unavailable');
+        foreach (explode("\0", rtrim($files, "\0")) as $entry)
+            self::need(str_starts_with($entry, 'H '), 'unsupported_checkout_flags');
+        return $sha;
+    }
+
+    private static function current(string $releases): string
+    {
+        self::directory($releases);
+        self::need(is_link($releases . '/current'), 'component_current_unavailable');
+        $target = readlink($releases . '/current');
+        self::need(is_string($target) && preg_match('~\A' . preg_quote($releases, '~') . '/[a-f0-9]{64}-[a-f0-9]{64}\z~D', $target) === 1,
+            'component_current_unavailable');
+        self::directory($target);
+        self::absent($releases . '/pending.json');
+        return $target;
+    }
+
+    private static function publicHost(array $paths, array $readers): array
+    {
+        $current = self::current($paths['public_releases']);
+        $seal = self::document($current . '/deployment.json');
+        $marker = self::document($paths['public_marker']);
+        $release = self::document($current . '/release.json');
+        $fingerprint = ($readers['public_fingerprint'])();
+        self::need(preg_match('/\A[a-f0-9]{64}\z/D', (string)$fingerprint) === 1
+            && ($seal['contract'] ?? null) === 'selection-public-host-v1'
+            && ($seal['origin'] ?? null) === 'https://tours.anytoour.ru'
+            && ($seal['fingerprint'] ?? null) === $fingerprint
+            && preg_match('/\A[a-f0-9]{40}\z/D', (string)($seal['source'] ?? '')) === 1
+            && self::encoded($seal) === self::encoded($marker), 'public_component_unaccepted');
+        $id = $release['package_id'] ?? '';
+        $identity = $release; unset($identity['package_id']);
+        self::need(preg_match('/\A[a-f0-9]{64}\z/D', (string)$id) === 1
+            && $id === hash('sha256', self::encoded($identity) . "\n")
+            && ($seal['package_id'] ?? null) === $id
+            && $current === $paths['public_releases'] . '/' . $id . '-' . $fingerprint,
+            'public_component_unaccepted');
+        $payload = [];
+        foreach (['view.php', 'selection.css', 'activity.js'] as $name) {
+            $file = self::file($current . '/' . $name);
+            self::need(($release['files'][$name]['sha256'] ?? null) === $file['sha256']
+                && ($release['files'][$name]['bytes'] ?? null) === strlen($file['raw']), 'public_payload_drift');
+            $payload[$name] = ['sha256' => $file['sha256'], 'mode' => $file['mode']];
+        }
+        $front = [];
+        foreach (['index.php', 'photo.php', 'activity.php'] as $name) $front[$name] = self::metadata($paths['site'] . '/' . $name, 32768);
+        foreach (['selection.css', 'activity.js'] as $name)
+            self::need(is_link($paths['site'] . '/' . $name)
+                && readlink($paths['site'] . '/' . $name) === $paths['public_releases'] . '/current/' . $name, 'public_asset_pointer_drift');
+        return ['package_id' => $id, 'source_sha' => $seal['source'], 'backend_fingerprint' => $fingerprint,
+            'seal' => self::metadata($current . '/deployment.json', 32768), 'marker' => self::metadata($paths['public_marker'], 32768),
+            'payload' => $payload, 'front' => $front];
+    }
+
+    private static function editorHost(array $paths, array $readers): array
+    {
+        $releases = $paths['editor_releases'];
+        $current = self::current($releases);
+        // The existing owner validates every sealed payload and its backend compatibility.
+        $installed = ($readers['editor'])($paths['root'], $releases);
+        self::need(is_array($installed) && ($installed['directory'] ?? null) === $current
+            && preg_match('/\A[a-f0-9]{64}\z/D', (string)($installed['package_id'] ?? '')) === 1
+            && preg_match('/\A[a-f0-9]{64}\z/D', (string)($installed['fingerprint'] ?? '')) === 1
+            && preg_match('/\A[a-f0-9]{40}\z/D', (string)($installed['source'] ?? '')) === 1, 'editor_component_unaccepted');
+        $accepted = self::document($current . '/accepted.json');
+        $seal = self::metadata($current . '/deployment.json', 32768);
+        self::need(($accepted['schema'] ?? null) === 1 && ($accepted['package_id'] ?? null) === $installed['package_id']
+            && ($accepted['seal_sha256'] ?? null) === $seal['sha256'], 'editor_component_unaccepted');
+        $operations = [];
+        if (file_exists($releases . '/operations') || is_link($releases . '/operations')) {
+            self::directory($releases . '/operations');
+            foreach (new FilesystemIterator($releases . '/operations', FilesystemIterator::SKIP_DOTS) as $file) {
+                self::need(count($operations) < 256 && preg_match('/\A[A-Za-z0-9][A-Za-z0-9_-]{7,95}\.json\z/D', $file->getFilename()) === 1,
+                    'editor_operation_inventory_invalid');
+                $operation = self::document($file->getPathname());
+                self::need(in_array($operation['state'] ?? null, ['activated', 'rolled_back'], true), 'unfinished_component_operation');
+                $operations[$file->getFilename()] = self::metadata($file->getPathname(), 32768);
+            }
+        }
+        return ['package_id' => $installed['package_id'], 'source_sha' => $installed['source'],
+            'backend_fingerprint' => $installed['fingerprint'], 'seal' => $seal,
+            'active' => self::metadata($releases . '/active.json', 32768),
+            'front' => self::metadata($paths['site'] . '/editor.php', 32768),
+            'operations_sha256' => hash('sha256', self::encoded($operations))];
+    }
+
+    private static function migrations(array $paths, array $readers): array
+    {
+        $rows = ($readers['migration_rows'])();
+        self::need(is_array($rows) && count($rows) > 0 && count($rows) <= 4096, 'migration_inventory_unavailable');
+        $applied = [];
+        foreach ($rows as $row) {
+            $version = $row['version'] ?? '';
+            self::need(is_string($version) && preg_match('/\A[A-Za-z0-9_-]+\.sql\z/D', $version) === 1 && !isset($applied[$version])
+                && preg_match('/\A[a-f0-9]{64}\z/D', (string)($row['checksum'] ?? '')) === 1
+                && in_array($row['baseline'] ?? null, [0, 1, '0', '1'], true), 'migration_inventory_invalid');
+            $applied[$version] = ['checksum' => $row['checksum'], 'baseline' => (int)$row['baseline']];
+        }
+        $files = glob($paths['root'] . '/migrations/*.sql');
+        self::need(is_array($files) && count($files) === count($applied), 'migration_inventory_mismatch');
+        foreach ($files as $file) self::need(($applied[basename($file)]['checksum'] ?? null) === self::file($file)['sha256'], 'migration_checksum_mismatch');
+        return ['count' => count($applied), 'sha256' => hash('sha256', self::encoded($applied))];
+    }
+
+    public static function capture(array $paths, array $readers, ?int $now = null): array
+    {
+        self::directory($paths['root']); self::directory($paths['site']);
+        $sha = self::checkout($readers);
+        $config = ['runtime' => self::metadata($paths['root'] . '/config.php'), 'external' => self::metadata($paths['external_config'])];
+        $status = ($readers['pipeline_status'])();
+        self::need(is_array($status) && ($status['schema_version'] ?? null) === 1 && ($status['project'] ?? null) === 'anytour'
+            && ($status['counter_id'] ?? null) === '98615635' && ($status['role'] ?? null) === 'pipeline'
+            && is_bool($status['configured'] ?? null), 'pipeline_configuration_unavailable');
+        $activation = $paths['pipeline'] . '/activation.json';
+        if ($status['configured']) {
+            self::directory($paths['pipeline']);
+            $pipeline = ['configured' => true, 'activation' => self::metadata($activation, 2048)];
+        } else {
+            self::absent($activation);
+            $pipeline = ['configured' => false];
+        }
+        $cron = self::command($readers, ['crontab', '-l'], 'cron_configuration_unavailable');
+        self::need(strlen($cron) <= 65536 && !str_contains($cron, "\0"), 'cron_configuration_unavailable');
+        $active = array_values(array_filter(explode("\n", $cron), static fn(string $line): bool => trim($line) !== '' && !str_starts_with(ltrim($line), '#')));
+        foreach (['cron_metrika.php', 'tools/channel_post_worker.php --platform=max --run --reconcile',
+            'tools/manager_prepared_replies.php tick', 'tools/hotel_work.php tick', 'tools/development_work.php tick',
+            'tools/modeled_conversion_monitor_local.py --cron'] as $owned) {
+            $count = count(array_filter($active, static fn(string $line): bool => str_contains($line, $paths['root'] . '/' . $owned)));
+            $wanted = $owned === 'tools/modeled_conversion_monitor_local.py --cron' && !$status['configured'] ? 0 : 1;
+            self::need($count === $wanted, 'cron_configuration_drift');
+        }
+        $extensions = get_loaded_extensions(); sort($extensions, SORT_STRING);
+        $components = ['configuration' => $config, 'cron' => ['sha256' => hash('sha256', $cron)],
+            'php' => ['version' => PHP_VERSION, 'extensions_sha256' => hash('sha256', self::encoded($extensions))],
+            'pipeline' => $pipeline, 'migrations' => self::migrations($paths, $readers),
+            'public_host' => self::publicHost($paths, $readers), 'editor_host' => self::editorHost($paths, $readers)];
+        $health = ($readers['webhook'])();
+        self::need(is_array($health) && ($health['ok'] ?? null) === true, 'max_ownership_unhealthy');
+        // Reject a source/config/cron change during the bounded observation.
+        self::need(self::checkout($readers) === $sha
+            && self::metadata($paths['root'] . '/config.php') === $config['runtime']
+            && self::metadata($paths['external_config']) === $config['external']
+            && self::command($readers, ['crontab', '-l'], 'cron_configuration_unavailable') === $cron, 'runtime_state_changed');
+        $state = ['schema' => 1, 'application_sha' => $sha, 'components' => $components];
+        return $state + ['ok' => true, 'fingerprint' => hash('sha256', self::encoded($state)),
+            'observed_at' => gmdate('Y-m-d\TH:i:s\Z', $now ?? time())];
+    }
+
+    /** Fixed executable set, no shell, no stdin, no inherited Git overrides, bounded output/time. */
+    public static function run(array $arguments, string $root): array
+    {
+        $binary = array_shift($arguments);
+        self::need(in_array($binary, ['git', 'crontab', 'python3'], true), 'runtime_command_invalid');
+        if ($binary === 'git') $arguments = ['-c', 'core.fsmonitor=false', '-c', 'core.untrackedCache=false', ...$arguments];
+        $process = proc_open(['/usr/bin/' . $binary, ...$arguments], [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, $root,
+            ['PATH' => '/usr/bin:/bin', 'LANG' => 'C', 'LC_ALL' => 'C', 'GIT_OPTIONAL_LOCKS' => '0',
+                'GIT_NO_REPLACE_OBJECTS' => '1', 'GIT_CONFIG_NOSYSTEM' => '1', 'GIT_CONFIG_GLOBAL' => '/dev/null']);
+        self::need(is_resource($process), 'runtime_command_unavailable');
