+def workflow_condition(expression, values):
+    """Evaluate the small real Actions condition subset, not a copied routing table."""
+    expression = expression.replace('always()', 'True').replace('success()', 'True')
+    expression = re.sub(r'\bsteps\.[A-Za-z_][A-Za-z0-9_.]*',
+                        lambda match: repr(values.get(match.group(0), '')), expression)
+    tree = ast.parse(expression.replace('&&', ' and ').replace('||', ' or '), mode='eval')
+    allowed = (ast.Expression, ast.BoolOp, ast.Compare, ast.Constant, ast.And, ast.Or, ast.Eq, ast.NotEq)
+    if any(not isinstance(node, allowed) for node in ast.walk(tree)):
+        raise AssertionError('Unsupported production condition: ' + expression)
+    return bool(eval(compile(tree, '<production-step-condition>', 'eval'), {'__builtins__': {}}, {}))
