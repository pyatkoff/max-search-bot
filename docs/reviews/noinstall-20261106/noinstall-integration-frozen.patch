+    def test_repeated_preview_is_deterministic_and_has_no_repository_write(self):
+        def state():
+            return (self.fx.git('rev-parse', 'HEAD'), self.fx.git('status', '--porcelain'),
+                    self.fx.git('for-each-ref', '--format=%(refname) %(objectname)'))
