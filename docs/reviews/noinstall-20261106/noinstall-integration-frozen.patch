+              name + ': common authenticated adapter is mandatory before operations')
+        check('  actions: read' in top_section(source, 'permissions').splitlines(),
+              name + ': adapter can authenticate Actions artifacts')
+        check(all('${{ secrets.' not in step for step in steps[:release[0] + 1]),
