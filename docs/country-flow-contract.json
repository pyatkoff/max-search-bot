  },
  "migration_readiness": {
    "runtime_migration_allowed": false,
    "reason": "callback_slice_requires_production_green_and_separate_free_text_authorization",
    "required_before_runtime": [
      "confirm the callback-only update slice production-green",
      "record a separate explicit free-text authorization checkpoint",
      "define checked update-only free-text behavior for missing and pre-start rows",
      "add a real-handler free-text regression",
      "preserve short validation, rich AI routing, edit and back behavior",
      "keep AI normalization, hints, defaults and upsert semantics unchanged"
    ]
  },
  "protected_non_goals": [
    "callback payload changes",
    "directory query changes",
    "stored country value changes",
    "AI normalization or default changes",
    "URL or Tourvisor projection changes",
    "country or date runtime mutation",
    "Yandex Metrica or goal changes",
    "lead delivery changes",
    "manager shift or routing changes"
  ]
