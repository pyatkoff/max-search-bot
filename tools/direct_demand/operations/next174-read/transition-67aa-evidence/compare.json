cy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ec3420fc19d9328b0c4ce497325442af6d21d647","url":"https://api.github.com/repos/pyatkoff/max-search-bot/commits/ec3420fc19d9328b0c4ce497325442af6d21d647","html_url":"https://github.com/pyatkoff/max-search-bot/commit/ec3420fc19d9328b0c4ce497325442af6d21d647"},{"sha":"aa33705515a7dcfe467b6262c75356416ebdab0a","url":"https://api.github.com/repos/pyatkoff/max-search-bot/commits/aa33705515a7dcfe467b6262c75356416ebdab0a","html_url":"https://github.com/pyatkoff/max-search-bot/commit/aa33705515a7dcfe467b6262c75356416ebdab0a"}]}],"files":[{"sha":"be558b26c6f6fedb287ce2e07f090b837f7f7462","filename":"services/ModeledConversionTextSignals.php","status":"modified","additions":14,"deletions":1,"changes":15,"blob_url":"https://github.com/pyatkoff/max-search-bot/blob/67aa3aef0debacfea01e845029b38a0db2f20b0d/services%2FModeledConversionTextSignals.php","raw_url":"https://github.com/pyatkoff/max-search-bot/raw/67aa3aef0debacfea01e845029b38a0db2f20b0d/services%2FModeledConversionTextSignals.php","contents_url":"https://api.github.com/repos/pyatkoff/max-search-bot/contents/services%2FModeledConversionTextSignals.php?ref=67aa3aef0debacfea01e845029b38a0db2f20b0d","patch":"@@ -28,7 +28,20 @@ public static function criteriaFamilies(string $text):array\n             'budget'=>'бюджет\\pL*|\\d[\\d ,.]*\\s*(?:тыс(?:яч\\pL*)?|руб\\pL*|₽|доллар\\pL*|евро)|до\\s+\\d+\\s*[$€]',\n             'requirements'=>'вс[её]\\s+включено|ультра\\s+вс[её]|первая\\s+лини\\pL*|первой\\s+лини\\pL*|песчан\\pL*\\s+пляж|подогрева\\pL*\\s+бассейн|аквапарк|детск\\pL*\\s+(?:клуб|меню)|[345]\\s*(?:зв[её]зд\\pL*|\\*)|без\\s+пересад\\pL*',\n         ];\n-        $out=[];foreach($rules as$family=>$pattern)if(self::hit($pattern,$text))$out[]=$family;return$out;\n+        $categoryText=$calendarText=$text;$starRanges=0;\n+        if(str_contains($text,'/')){\n+            $range='[1-5](?:\\h*/\\h*[1-5])+';\n+            // Closing Markdown emphasis in “*departure 4/5*” is not a hotel star.\n+            $categoryText=preg_replace('~(?<![\\pL\\pN*])(\\*{1,3})(?![\\s*])((?:(?!\\1)[^\\r\\n])*?(?<![\\d./])'.$range.')\\1(?!\\*)~u','$2',$text)??$text;\n+            // Remove only marked categories. Independent dates and durations keep their original source.\n+            $calendarText=preg_replace('~(?<![\\d./])'.$range.'\\h*(?:зв[её]зд\\pL*|[*★⭐])~iu',' ',$categoryText,-1,$starRanges)??$categoryText;\n+        }\n+        $out=[];\n+        foreach($rules as$family=>$pattern){\n+            $input=match($family){'dates'=>$calendarText,'requirements'=>$categoryText,default=>$text};\n+            if(($family==='requirements'&&$starRanges>0)||self::hit($pattern,$input))$out[]=$family;\n+        }\n+        return $out;\n     }\n     private static function hit(string $pattern,string $text):bool{return preg_match('~'.$pattern.'~iu',$text)===1;}\n }"},{"sha":"bbb4206efa16e0881400eb1779a8af062da1a0e0","filename":"tests/run_modeled_conversion_semantic_prediction_regression.php","status":"modified","additions":37,"deletions":0,"changes":37,"blob_url":"https://github.com/pyatkoff/max-search-bot/blob/67aa3aef0debacfea01e845029b38a0db2f20b0d/tests%2Frun_modeled_conversion_semantic_prediction_regression.php","raw_url":"https://github.com/pyatkoff/max-search-bot/raw/67aa3aef0debacfea01e845029b38a0db2f20b0d/tests%2Frun_modeled_conversion_semantic_prediction_regression.php","contents_url":"https://api.github.com/repos/pyatkoff/max-search-bot/contents/tests%2Frun_modeled_conversion_semantic_prediction_regression.php?ref=67aa3aef0debacfea01e845029b38a0db2f20b0d","patch":"@@ -187,6 +187,43 @@ function semanticPredictionLegacyDigest(array $value):string\n     $logistics=semanticPredictionRun([['text'=>'Подберите тур в Турцию на 7 ночей.'],['text'=>'Где офис? Как оплатить картой?']]);\n     semanticPredictionAssert($logistics['stage']==='concrete_request','logistics became seller intent');\n };\n+$tests['hotel star ranges preserve independent calendar evidence and genuine hotel interest']=static function():void{\n+    require_once dirname(__DIR__).'/services/ModeledConversionValueContract.php';\n+    foreach(['И 3/4 звезд?','Нужно 1/2 звезды','Есть варианты 3/4 звезды?','Только 4/5*','Категория 3/4★','Отель 3* или 4/5*','**Категория 3/4** звезды','Подойдёт 4/5⭐️','Категория 3 / 4 звёзды']as$text){\n+        semanticPredictionAssert(ModeledConversionTextSignals::criteriaFamilies($text)===['requirements'],\n+            'hotel star range supplied a calendar criterion');\n+    }\n+    foreach(['Вылет **4/5**','Вылет *4/5*','**Вылет 4/5**']as$text){\n+        semanticPredictionAssert(ModeledConversionTextSignals::criteriaFamilies($text)===['dates'],\n+            'paired emphasis hid a calendar date or introduced a hotel category');\n+    }\n+    foreach(['**Отель 3/4* с вылетом 4/5**','Категория 3/4 звезды, заезд 11/12/2027.','Заезд 3/4, отель 3/4 звезды',\n+        'На 8 ночей нужен отель 4/5*','Категория 3/4 звезды, вылет с 09.12 по 16.12.']as$text){\n+        semanticPredictionAssert(ModeledConversionTextSignals::criteriaFamilies($text)===['dates','requirements'],\n+            'rating masked a separate date or duration in the same turn');\n+    }\n+    $freeze=static function(array $messages):array{\n+        [$case,$w,$doc]=semanticPredictionFreezeFixture($messages,'max');\n+        $clock=strtotime($doc['requested_at']);$w+=ModeledConversionEarlyForecast::freeze($case,$w,$doc,null,$clock,null,true);\n+        $w['deal_value_prediction']=ModeledConversionDealValue::freeze($w,$case);\n+        return [$w,ModeledConversionValueContract::candidate($w,$w['subject'],$clock-3600,$clock)];\n+    };\n+    [$w,$candidate]=$freeze([['text'=>'И 3/4 звезд?']]);\n+    semanticPredictionAssert($w['semantic_prediction']['current_request_anchor']===null&&$candidate===null,\n+        'bare rating question created a standalone financial candidate');\n+    [$w,$candidate]=$freeze([['text'=>'Подберите отель 3/4 звезды.']]);\n+    semanticPredictionAssert($w['semantic_prediction']['stage']==='substantive_dialogue'\n+        &&$w['semantic_prediction']['features']['criteria_families']===['requirements']\n+        &&($candidate['stage']??null)==='interest'&&$candidate['value']===500,\n+        'explicit hotel interest was lost or promoted to a two-criterion financial request');\n+\n+    [$w]=$freeze([['text'=>'Подберите тур с 10.03 по 19.03.'],['text'=>'Покажете варианты 3/4 звезды?']]);\n+    $p=$w['semantic_prediction'];$refs=array_column($p['evidence'],'source_ref','feature');\n+    semanticPredictionAssert($p['current_request_anchor']==='journal:1'&&$p['stage']==='concrete_request'\n+        &&$p['features']['criteria_families']===['dates','requirements']\n+        &&($refs['criteria_dates']??null)==='journal:1'&&($refs['criteria_requirements']??null)==='journal:2',\n+        'later hotel rating replaced the evidence for an independently supplied travel period');\n+};\n $tests['bounded criteria handle countries outside canonical narrow vocabulary']=static function():void{\n     $p=semanticPredictionRun([['text'=>'Испания в июле, 2 взрослых, бюджет 200 тысяч.']]);\n     semanticPredictionAssert($p['stage']==='concrete_request'"}]}
